# Copy to .env in the repository root and edit.
HOME=/home/you
# Where your git checkouts live; mounted read-write because the watcher releases them.
PROJECTS_ROOT=/home/you/projects
# Bind address for the board. Use the Tailscale IP to reach it from other devices.
T3_BOARD_HOST=127.0.0.1
T3_BOARD_PORT=8787
# Match your host user so mounted files keep their owner.
T3_UID=1000
T3_GID=1000
